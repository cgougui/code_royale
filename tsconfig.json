{
  "extends": "./tsconfig.base.json",
  // The React app. Packages are type-checked on their own (see "typecheck" in package.json).
  "include": ["app", "tools", ".react-router/types/**/*", "*.ts"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022", "WebWorker"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": { "~/*": ["./app/*"] },
    "esModuleInterop": true
  }
}
